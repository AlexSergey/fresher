{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "ignoreBinaries": ["gitleaks", "rustfmt", "taplo", "typos"]
    },
    "app/ui": {
      "entry": ["gallery.html", "src/gallery/main.tsx", "src/**/*.stories.tsx"],
      "ignore": ["src/**/*.generated.ts"]
    }
  }
}
