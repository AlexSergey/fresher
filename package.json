{
  "name": "fresher",
  "version": "0.1.0",
  "private": true,
  "description": "A fast macOS disk cleaner: a Rust core with a Tauri 2 shell and a React UI",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexSergey/fresher.git"
  },
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "workspaces": [
    "app/ui"
  ],
  "scripts": {
    "bench": "cargo bench -p fresher-scanner --bench scan --locked",
    "build": "tauri build",
    "check:crate-deps": "node scripts/check-crate-deps.ts",
    "check:deny": "cargo deny check",
    "check:machete": "cargo machete",
    "check:repo": "npm run check:staged && npm run check:secrets && npm run check:typos",
    "check:secrets": "gitleaks git --pre-commit --staged --redact --no-banner",
    "check:staged": "node scripts/check-staged.ts",
    "check:typos": "typos",
    "demo:check": "node scripts/demo-record.ts --check",
    "demo:record": "node scripts/demo-record.ts",
    "dev": "node scripts/dev.ts",
    "dev:sandbox": "node scripts/sandbox-dev.ts",
    "dev-runs:check": "node scripts/dev-runs-check.ts",
    "format": "npm run format:prettier && npm run format:code && cargo fmt --all && taplo fmt",
    "format:code": "eslint . --fix",
    "format:prettier": "prettier --write .",
    "knip": "knip",
    "lint": "npm run lint:rust && npm run lint:ts && npm run lint:code",
    "lint:code": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:commit": "commitlint --config .commitlintrc.cjs --edit",
    "lint:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "lint:ts": "tsc --noEmit -p . && tsc --noEmit -p app/ui",
    "pre-commit": "lint-staged --config .lintstagedrc.cjs",
    "pre-push": "npm run lint && npm run check:crate-deps && npm run knip && npm run check:machete && npm run check:deny && npm run test:scripts && npm run test:cov",
    "prepare": "husky",
    "sandbox": "cargo run -q -p fresher-sandbox --locked -- generate",
    "sandbox:test": "cargo nextest run -p fresher-app --test sandboxes --locked",
    "tauri": "tauri",
    "test": "npm run test:rust && npm run test:ui && npm run test:scripts",
    "test:cov": "npm run test:cov:rust && npm run test:cov:ui",
    "test:cov:rust": "node -e \"fs.mkdirSync('coverage/rust', { recursive: true })\" && cargo llvm-cov nextest --workspace --locked --fail-under-lines 90 --ignore-filename-regex 'app/tauri/src/main.rs' --lcov --output-path coverage/rust/lcov.info",
    "test:cov:ui": "npm run test:cov --workspace app/ui",
    "test:e2e": "npm run test:e2e:core && npm run test:e2e:ui",
    "test:e2e:core": "cargo nextest run -p fresher-e2e --locked",
    "test:e2e:ui": "npm run test:e2e --workspace app/ui",
    "test:rust": "cargo nextest run --workspace --locked",
    "test:scripts": "node --test scripts/*.test.ts",
    "test:ui": "npm run test --workspace app/ui"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint-react/eslint-plugin": "5.30.2",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.15.0",
    "eslint-config-flat-gitignore": "2.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-lite": "0.6.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-package-json": "1.14.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-regexp": "3.3.3",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unicorn": "79.0.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "knip": "6.45.1",
    "lint-staged": "17.6.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.0.0"
  }
}
