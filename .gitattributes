# Autodetect text files and force unix line endings
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.icns binary
*.ico binary
*.mp4 binary
*.sqlite binary

# Generated files: collapsed on GitHub, but their diffs stay readable for review (docs/restrictions/dependencies.md)
Cargo.lock linguist-generated=true
package-lock.json linguist-generated=true
