{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window's permissions: the app's own commands, and two window permissions for the drag region of the overlay title bar (dragging the window, and zooming it by a double click, as every Mac window does); no other core or plugin permission, no network, no shell, no file system.",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-subscribe",
    "allow-start-scan",
    "allow-cancel-scan",
    "allow-get-overview",
    "allow-get-modules",
    "allow-get-findings",
    "allow-get-settings",
    "allow-update-setting",
    "allow-reset-settings",
    "allow-ignore",
    "allow-restore-ignored",
    "allow-pick-folder",
    "allow-get-own-data",
    "allow-get-storage-map",
    "allow-get-storage-meaning",
    "allow-get-largest",
    "allow-get-largest-place",
    "allow-pick-own-item",
    "allow-get-dictionary",
    "allow-get-access-status",
    "allow-refresh-access",
    "allow-open-access-settings",
    "allow-reveal-finding",
    "allow-relaunch",
    "allow-prepare-cleanup",
    "allow-discard-cleanup",
    "allow-confirm-cleanup",
    "allow-cancel-cleanup",
    "allow-get-cleanups",
    "allow-get-cleanup",
    "allow-put-back",
    "allow-reveal-in-trash",
    "allow-get-trash",
    "allow-open-trash",
    "allow-quit-after-cleanup",
    "allow-demo-play",
    "allow-demo-finished",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
