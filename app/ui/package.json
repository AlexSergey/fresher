{
  "name": "@fresher/ui",
  "version": "0.3.0",
  "private": true,
  "description": "The user interface of Fresher",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexSergey/fresher.git",
    "directory": "app/ui"
  },
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:e2e": "tsc --noEmit && vite build --mode e2e",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test --project gallery --project webkit --project chromium",
    "test:e2e:update": "playwright test --project gallery --project webkit --project chromium --update-snapshots",
    "test:perf": "playwright test --project perf --project perf-chromium --workers 1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "happy-dom": "21.0.4",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
